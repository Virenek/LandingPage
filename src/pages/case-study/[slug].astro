---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const studies = await getCollection('case-study', ({ data }) => !data.draft);
  return studies.map(study => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

const { study } = Astro.props;
const { Content } = await study.render();
---

<Layout title={`${study.data.title} | Michał Kuś`} description={study.data.description}>
  <style>
    .cs-header {
      padding: 8rem 0 3rem;
      background: var(--primary-container);
      border-bottom: 1px solid var(--outline-variant);
    }
    .cs-header .chip { border-color: rgba(26,59,52,.3); color: var(--on-primary-container); }
    .cs-meta {
      display: flex;
      gap: .75rem;
      align-items: center;
      margin-bottom: 1rem;
    }
    .cs-industry {
      font-family: var(--mono);
      font-size: .68rem;
      letter-spacing: .06em;
      color: var(--on-primary-container);
      background: rgba(255,255,255,.35);
      padding: .25rem .7rem;
      border-radius: var(--shape-full);
    }
    .cs-date {
      font-family: var(--mono);
      font-size: .68rem;
      color: var(--on-primary-container);
      opacity: .75;
      letter-spacing: .04em;
    }
    .cs-header h1 {
      font-size: clamp(1.8rem, 4vw, 2.6rem);
      max-width: 760px;
      color: var(--on-primary-container);
      margin-bottom: 1rem;
    }
    .cs-header .description {
      font-size: 1rem;
      max-width: 640px;
      color: var(--on-primary-container);
      opacity: .8;
    }
    .cs-body {
      padding: 4rem 0 6rem;
      background: var(--background);
    }
    .cs-content {
      max-width: 720px;
    }
    .cs-content :global(h2) {
      font-size: 1.4rem;
      font-weight: 500;
      color: var(--on-surface);
      margin: 2.5rem 0 1rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--outline-variant);
    }
    .cs-content :global(h2:first-child) { border-top: none; padding-top: 0; }
    .cs-content :global(h3) {
      font-size: 1.05rem;
      font-weight: 500;
      color: var(--primary);
      font-family: var(--mono);
      letter-spacing: .04em;
      text-transform: uppercase;
      font-size: .75rem;
      margin: 2rem 0 .6rem;
    }
    .cs-content :global(p) {
      color: var(--on-surface-variant);
      line-height: 1.8;
      margin-bottom: 1.25rem;
      font-size: .975rem;
    }
    .cs-content :global(ul), .cs-content :global(ol) {
      padding-left: 1.5rem;
      margin-bottom: 1.25rem;
    }
    .cs-content :global(li) {
      color: var(--on-surface-variant);
      line-height: 1.8;
      margin-bottom: .4rem;
      font-size: .975rem;
    }
    .cs-content :global(strong) { color: var(--on-surface); font-weight: 600; }
    .cs-content :global(blockquote) {
      border-left: 3px solid var(--primary);
      padding: 1rem 1.5rem;
      margin: 1.5rem 0;
      background: var(--surface-container);
      border-radius: 0 var(--shape-md) var(--shape-md) 0;
    }
    .cs-content :global(blockquote p) { margin-bottom: 0; font-style: italic; }
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      font-family: var(--mono);
      font-size: .72rem;
      letter-spacing: .06em;
      color: var(--primary);
      margin-bottom: 3rem;
    }
    .back-link:hover { text-decoration: underline; }
  </style>

  <section class="cs-header">
    <div class="container">
      <div class="chip">Case Study</div>
      <div class="cs-meta">
        {study.data.industry && <span class="cs-industry">{study.data.industry}</span>}
        <span class="cs-date">
          {study.data.date.toLocaleDateString('pl-PL', { year: 'numeric', month: 'long' })}
        </span>
      </div>
      <h1>{study.data.title}</h1>
      <p class="description">{study.data.description}</p>
    </div>
  </section>

  <section class="cs-body">
    <div class="container">
      <a href="/case-study" class="back-link">← Wszystkie case study</a>
      <div class="cs-content">
        <Content />
      </div>
    </div>
  </section>
</Layout>
