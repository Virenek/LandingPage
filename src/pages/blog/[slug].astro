---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout title={`${post.data.title} | Michał Kuś`} description={post.data.description}>
  <style>
    .post-header {
      padding: 8rem 0 3rem;
      background: var(--surface);
      border-bottom: 1px solid var(--outline-variant);
    }
    .post-meta {
      font-family: var(--mono);
      font-size: .7rem;
      color: var(--on-surface-variant);
      letter-spacing: .06em;
      margin-bottom: 1rem;
    }
    .post-header h1 {
      font-size: clamp(1.8rem, 4vw, 2.8rem);
      max-width: 760px;
      margin-bottom: 1rem;
    }
    .post-header .description {
      font-size: 1rem;
      max-width: 640px;
      color: var(--on-surface-variant);
    }
    .post-body {
      padding: 4rem 0 6rem;
      background: var(--background);
    }
    .post-content {
      max-width: 720px;
    }
    .post-content :global(h2) {
      font-size: 1.5rem;
      font-weight: 500;
      color: var(--on-surface);
      margin: 2.5rem 0 1rem;
      line-height: 1.3;
    }
    .post-content :global(h3) {
      font-size: 1.15rem;
      font-weight: 500;
      color: var(--on-surface);
      margin: 2rem 0 .75rem;
    }
    .post-content :global(p) {
      color: var(--on-surface-variant);
      line-height: 1.8;
      margin-bottom: 1.25rem;
      font-size: .975rem;
    }
    .post-content :global(ul), .post-content :global(ol) {
      padding-left: 1.5rem;
      margin-bottom: 1.25rem;
    }
    .post-content :global(li) {
      color: var(--on-surface-variant);
      line-height: 1.8;
      margin-bottom: .4rem;
      font-size: .975rem;
    }
    .post-content :global(strong) { color: var(--on-surface); font-weight: 600; }
    .post-content :global(blockquote) {
      border-left: 3px solid var(--primary);
      padding: 1rem 1.5rem;
      margin: 1.5rem 0;
      background: var(--surface-container);
      border-radius: 0 var(--shape-md) var(--shape-md) 0;
    }
    .post-content :global(blockquote p) { margin-bottom: 0; font-style: italic; }
    .post-content :global(code) {
      font-family: var(--mono);
      font-size: .85em;
      background: var(--surface-container);
      padding: .15em .4em;
      border-radius: var(--shape-sm);
      color: var(--primary);
    }
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      font-family: var(--mono);
      font-size: .72rem;
      letter-spacing: .06em;
      color: var(--primary);
      margin-bottom: 3rem;
    }
    .back-link:hover { text-decoration: underline; }
  </style>

  <section class="post-header">
    <div class="container">
      <div class="chip chip-tonal">Blog</div>
      <div class="post-meta">
        {post.data.date.toLocaleDateString('pl-PL', { year: 'numeric', month: 'long', day: 'numeric' })}
      </div>
      <h1>{post.data.title}</h1>
      <p class="description">{post.data.description}</p>
    </div>
  </section>

  <section class="post-body">
    <div class="container">
      <a href="/blog" class="back-link">← Wszystkie wpisy</a>
      <div class="post-content">
        <Content />
      </div>
    </div>
  </section>
</Layout>
